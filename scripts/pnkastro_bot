#!/usr/bin/env bash
set -euo pipefail

DEFAULT_SERVICE=picobot

usage() {
  echo "Usage: $0 [<service>] [restart|status|logs]"
  echo "If only one arg is provided and it is one of restart|status|logs,"
  echo "it will operate on the default service ($DEFAULT_SERVICE)."
  echo "Examples:" 
  echo "  $0 restart            # restarts default service ($DEFAULT_SERVICE)"
  echo "  $0 picobot restart    # restarts 'picobot' service"
  exit 1
}

# Parse args: allow either (cmd) or (service cmd)
if [ "$#" -eq 0 ]; then
  SERVICE="$DEFAULT_SERVICE"
  CMD=restart
elif [ "$#" -eq 1 ]; then
  case "$1" in
    restart|status|logs)
      SERVICE="$DEFAULT_SERVICE"
      CMD="$1"
      ;;
    *)
      SERVICE="$1"
      CMD=restart
      ;;
  esac
else
  SERVICE="$1"
  CMD="$2"
fi

case "$CMD" in
  restart)
    if [ "$EUID" -ne 0 ]; then
      sudo systemctl restart "$SERVICE"
    else
      systemctl restart "$SERVICE"
    fi
    sleep 1
    systemctl status "$SERVICE" --no-pager -l
    ;;
  status)
    systemctl status "$SERVICE" --no-pager -l
    ;;
  logs)
    journalctl -u "$SERVICE" --no-pager -n 200
    ;;
  *)
    usage
    ;;
esac


